# PostgreSQL application and migration roles
DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@127.0.0.1:5432/b2b_stm
MIGRATION_DATABASE_URL=postgresql://MIGRATION_USER:MIGRATION_PASSWORD@127.0.0.1:5432/b2b_stm
TEST_DATABASE_URL=postgresql://TEST_APP_USER:TEST_APP_PASSWORD@127.0.0.1:5432/b2b_stm_test
TEST_MIGRATION_DATABASE_URL=postgresql://TEST_MIGRATION_USER:TEST_MIGRATION_PASSWORD@127.0.0.1:5432/b2b_stm_test

# Local web/API boundary
APP_ORIGIN=http://127.0.0.1:3101
API_HOST=127.0.0.1
API_PORT=3200

# Generate independent random hex values; never reuse these placeholders.
CSRF_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_64_HEX_CHARACTERS

# Optional in development. Production requires SMTP_URL and MAIL_FROM.
# MAIL_TRANSPORT=json
# SMTP_URL=smtps://USER:PASSWORD@SMTP_HOST:465
# MAIL_FROM=STM <no-reply@example.test>
# NOTIFICATION_WORKER_ENABLED=false

# Attachment malware scanning. Production requires clamav and fails closed.
ATTACHMENT_SCAN_MODE=disabled
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_MS=5000
