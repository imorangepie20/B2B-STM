{
  "name": "b2b-stm",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*"],
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "db:verify": "node --env-file=.env.local scripts/verify-database.mjs",
    "db:rehearse-restore": "node --env-file=.env.local scripts/rehearse-backup-restore.mjs --development",
    "demo:seed": "node --env-file=.env.local scripts/seed-demo-data.mjs --development",
    "demo:reset": "node --env-file=.env.local scripts/reset-demo-data.mjs --development --confirm-reset",
    "demo:verify-browser": "node --env-file=.env.local apps/web/e2e/demo-data-smoke.cjs",
    "ui:verify-recent": "node --env-file=.env.local apps/web/e2e/recent-pages-visual-qa.cjs",
    "repo:verify-public": "node scripts/verify-public-repository.mjs",
    "import:verify-browser": "node --env-file=.env.local apps/web/e2e/initial-import-flow.cjs",
    "designlang:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/setup-designlang.ps1",
    "designlang:extract": "node .tools/designlang/node_modules/designlang/bin/design-extract.js",
    "ops:verify": "node --env-file=.env.local scripts/verify-operations.mjs",
    "ops:acceptance-smoke": "node --env-file=.env.local scripts/verify-operational-acceptance.mjs",
    "perf:provision": "node --env-file=.env.local scripts/provision-performance-db.mjs --confirm-create",
    "perf:migrate": "node --env-file=.env.local scripts/migrate.mjs --performance",
    "perf:seed:rehearsal": "node --env-file=.env.local scripts/seed-performance-data.mjs --profile=rehearsal --confirm-reset",
    "perf:seed:target": "node --env-file=.env.local scripts/seed-performance-data.mjs --profile=target --confirm-reset",
    "perf:benchmark": "node --env-file=.env.local scripts/run-performance-benchmark.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs --development",
    "test:foundation": "node --env-file=.env.local --test --test-concurrency=1 scripts/tests/*.test.mjs",
    "test:auth-redirect": "node --env-file=.env.local apps/web/e2e/login-flow.cjs",
    "test:fault-recovery": "node --env-file=.env.local --test scripts/tests/fault-recovery.test.mjs",
    "build:api": "npm run build --workspace=@b2b-stm/api",
    "build:web": "npm run build --workspace=@b2b-stm/web",
    "start:web": "npm run start --workspace=@b2b-stm/web -- --hostname 127.0.0.1 --port 3101",
    "admin:bootstrap": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
    "admin:reset-password": "node --env-file=.env.local scripts/reset-admin-password.mjs",
    "admin:verify": "node --env-file=.env.local scripts/verify-initial-admin.mjs",
    "auth:reset-login-limit": "node --env-file=.env.local scripts/reset-login-limits.mjs",
    "start:api": "node --env-file=.env.local apps/api/dist/main.js"
  },
  "devDependencies": { "pg": "8.23.0" }
}
